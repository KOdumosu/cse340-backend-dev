<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

<p>
    <a href="/new-category">
        Add New Category
    </a>
</p>

    <ul>

    <% categories.forEach(category => { %>

        <li>

            <a href="/categories/<%= category.category_id %>">
                <%= category.category_name %>
            </a>

            |

            <a href="/edit-category/<%= category.category_id %>">
                Edit
            </a>

        </li>

    <% }) %>

</ul>

    
</main>

<%- include('partials/footer') %>