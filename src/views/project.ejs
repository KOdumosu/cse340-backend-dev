<%- include('partials/header') %>

<main>

<h1><%= project.project_name %></h1>

<p>
    <strong>Organization:</strong>
    <%= project.organization_name %>
</p>

<p>
    <%= project.description %>
</p>

<h3>Categories</h3>

<ul>
    <% categories.forEach(category => { %>
        <li><%= category.category_name %></li>
    <% }) %>
</ul>

<% if (user && user.role_name === 'admin') { %>
    <p>
        <a href="/edit-project/<%= project.project_id %>">
            Edit Project
        </a>
    </p>
<% } %>

<% if (user) { %>

    <% if (!volunteerStatus) { %>

        <form
            action="/projects/<%= project.project_id %>/volunteer"
            method="POST">

            <button type="submit">Volunteer for this Project</button>

        </form>

    <% } else { %>

        <p>
            You are volunteering for this project?.
        </p>

        <form
            action="/projects/<%= project.project_id %>/unvolunteer"
            method="POST">

            <button type="submit">Remove Volunteer Status</button>

        </form>

    <% } %>

<% } %>

</main>

<%- include('partials/footer') %>